{
  "manifest_version": 3,
  "name": "Zeitnot: Live World Chess Championship",
  "version": "1.1.0",
  "description": "Live FIDE World Chess Championship probabilities, match score, clock telemetry, and next-game countdown with Pawnshot liquid-glass HUD.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://lichess.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Zeitnot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "110"
}
