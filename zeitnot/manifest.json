{
  "manifest_version": 3,
  "name": "Zeitnot: Live World Chess Championship",
  "version": "1.1.0",
  "description": "Live World Chess Championship companion: match score, win/draw/loss and title odds, ticking clocks and a time-trouble alert, on a toolbar badge and in a popup. Data from the free Lichess broadcast.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://lichess.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Zeitnot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "120"
}
