{
  "manifest_version": 3,
  "name": "Pawnshot: Chess Video Analysis & Position Scanner",
  "short_name": "Pawnshot",
  "version": "2.0.0",
  "description": "Follow a chess video move by move with Stockfish on your device. Scan a board from YouTube, a screenshot or picture. Fair-play safe.",
  "homepage_url": "https://github.com/vaibhav2740/chrome-extensions/tree/main/board-analyzer",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://api.lemonsqueezy.com/*",
    "https://api.gumroad.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pawnshot: show or hide (Alt+Shift+A)",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Show or hide Pawnshot"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
