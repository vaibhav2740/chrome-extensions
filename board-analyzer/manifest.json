{
  "manifest_version": 3,
  "name": "Board Analyzer",
  "version": "1.0.0",
  "description": "Floating chessboard + in-browser Stockfish best move on any page. Personal use.",
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Toggle analysis board (Alt+Shift+A)" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A", "mac": "Alt+Shift+A" },
      "description": "Toggle analysis board"
    }
  },
  "web_accessible_resources": [
    { "resources": ["panel.html", "panel.js", "panel.css", "lib/*", "engine/*"], "matches": ["<all_urls>"] }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
